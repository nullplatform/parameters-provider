#!/bin/bash
set -euo pipefail

# Retrieves a secret version from GCP Secret Manager by external_id via the REST API.
#
# The secret id is derived from EXTERNAL_ID_PATH with the same mapping store
# used (naming/gsm_secret_id). EXTERNAL_ID_VERSION targets a historical version;
# without it the latest enabled version is read.
#
# Required env: EXTERNAL_ID_PATH, EXTERNAL_ID_VERSION (set by build_context),
#               GSM_PROJECT_ID, GSM_API_URL, GSM_NAME_PREFIX, GCP_ACCESS_TOKEN

source "$(dirname "${BASH_SOURCE[0]}")/naming"

SECRET_ID=$(gsm_secret_id "$EXTERNAL_ID_PATH")
VERSION="${EXTERNAL_ID_VERSION:-}"
[ -z "$VERSION" ] && VERSION="latest"

resp_file=$(mktemp)
http_code=$(curl -s --max-time 30 -o "$resp_file" -w '%{http_code}' \
  -X GET "$GSM_API_URL/projects/$GSM_PROJECT_ID/secrets/$SECRET_ID/versions/$VERSION:access" \
  -H "Authorization: Bearer $GCP_ACCESS_TOKEN") || http_code="000"
resp=$(cat "$resp_file")
rm -f "$resp_file"

if [ "$http_code" = "200" ]; then
  if ! echo "$resp" | jq -e '.payload.data | type == "string"' >/dev/null 2>&1; then
    log error "❌ Secret Manager returned no payload for '$SECRET_ID' (version $VERSION)"
    log error ""
    log error "💡 Possible causes:"
    log error "   • The access response is malformed or was truncated by a proxy"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Verify: gcloud secrets versions access $VERSION --secret $SECRET_ID --project $GSM_PROJECT_ID"
    exit 1
  fi
  # Decode and build the JSON in one jq pass: going through a shell variable
  # would strip trailing newlines from the value.
  echo "$resp" | jq '{value: (.payload.data | @base64d)}'
elif [ "$http_code" = "404" ]; then
  log error "❌ Secret '$SECRET_ID' (version $VERSION) not found in GCP project '$GSM_PROJECT_ID'"
  log error ""
  log error "💡 Possible causes:"
  log error "   • The secret was manually deleted from Secret Manager"
  log error "   • The external_id is stale"
  if [ -n "${EXTERNAL_ID_VERSION:-}" ]; then
    log error "   • Requested version '$EXTERNAL_ID_VERSION' does not exist on the secret"
  fi
  log error ""
  log error "🔧 How to fix:"
  log error "   • Verify: gcloud secrets versions list $SECRET_ID --project $GSM_PROJECT_ID"
  log error "   • If genuinely missing, the parameter value needs to be re-stored"
  exit 1
else
  log error "❌ Failed to retrieve secret '$SECRET_ID' (version $VERSION) from GCP project '$GSM_PROJECT_ID' (HTTP $http_code)"
  log error ""
  log error "💡 Possible causes:"
  log error "   • The agent identity lacks secretmanager.versions.access on the secret"
  log error "   • The requested version is disabled or destroyed (HTTP 400 FAILED_PRECONDITION)"
  log error "   • The access token expired"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Grant the agent principal access as in docs/iam-policy.md"
  log error "   • Check the version state: gcloud secrets versions describe $VERSION --secret $SECRET_ID --project $GSM_PROJECT_ID"
  if [ "$http_code" = "000" ]; then
    log error "Underlying error: could not connect to secretmanager.googleapis.com — no HTTP response (DNS or network egress)"
  else
    log error "Underlying error: $(echo "$resp" | jq -r '.error.message // "unknown error"' 2>/dev/null | head -1)"
  fi
  exit 1
fi
