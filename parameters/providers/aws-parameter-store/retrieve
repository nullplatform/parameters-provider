#!/bin/bash
set -euo pipefail

# Retrieves a parameter from AWS Parameter Store by external_id.
# Uses --with-decryption (no-op for String, decrypts SecureString).
#
# Semantics:
#   - Success → return {value: "<value>"}
#   - ParameterNotFound → return {value: "value not found"}
#   - Any other error → exit 1 with troubleshooting
#
# Required env: EXTERNAL_ID, AWS_REGION, PS_NAME_PREFIX

# EXTERNAL_ID_PATH and EXTERNAL_ID_VERSION are set by build_context. The SSM
# name comes from ./naming, the same rule cache_key uses.
# shellcheck source=parameters/providers/aws-parameter-store/naming
source "$(dirname "${BASH_SOURCE[0]}")/naming"
PARAM_NAME=$(ps_parameter_name "$EXTERNAL_ID_PATH")

# PS addresses historical versions by suffixing `:<version>` to the parameter name.
LOOKUP_NAME="$PARAM_NAME"
[ -n "${EXTERNAL_ID_VERSION:-}" ] && LOOKUP_NAME="${PARAM_NAME}:${EXTERNAL_ID_VERSION}"

# Value cache fill (see utils/value_cache and ./cache_key): read every value
# under this parameter's path in one paginated get-parameters-by-path, so the
# rest of the deploy's retrieves are answered by the entrypoint from disk. Any
# failure here (e.g. a role without ssm:GetParametersByPath) only logs and
# falls through to the single get-parameter below, as before. A path already
# cached means the cache can't serve this value (e.g. an older version), so
# re-reading it would only repeat the whole path per such retrieve.
if [ -n "${SERVICE_PATH:-}" ] && [ -f "$SERVICE_PATH/utils/value_cache" ]; then
  source "$SERVICE_PATH/utils/value_cache"
  _vc_group="${PARAM_NAME%/*}"
  if value_cache_enabled && ! value_cache_fresh "$_vc_group"; then
    _vc_err=$(mktemp)
    if _vc_values=$(aws ssm get-parameters-by-path \
            --region "$AWS_REGION" \
            --path "$_vc_group" \
            --with-decryption \
            --query 'Parameters[].{n: Name, v: Value, ver: Version}' \
            --output json 2>"$_vc_err" \
          | jq -c 'map({key: .n, value: {value: .v, version: (.ver | tostring)}}) | from_entries'); then
      value_cache_write "$_vc_group" "$_vc_values" \
        && log debug "🗂️  value cache filled with $(jq 'length' <<<"$_vc_values") values from $_vc_group"
      if VALUE=$(value_cache_lookup "$_vc_group" "$PARAM_NAME" "${EXTERNAL_ID_VERSION:-}"); then
        rm -f "$_vc_err"
        jq -n --arg value "$VALUE" '{value: $value}'
        exit 0
      fi
    else
      log warn "⚠️  value cache fill failed, using get-parameter: $(cat "$_vc_err")"
    fi
    rm -f "$_vc_err"
  fi
fi

err_file=$(mktemp)
if VALUE=$(aws ssm get-parameter \
        --region "$AWS_REGION" \
        --name "$LOOKUP_NAME" \
        --with-decryption \
        --query Parameter.Value \
        --output text 2>"$err_file"); then
  rm -f "$err_file"
  jq -n --arg value "$VALUE" '{value: $value}'
else
  err=$(cat "$err_file")
  rm -f "$err_file"
  if echo "$err" | grep -q "ParameterNotFound"; then
    log error "❌ Parameter '$PARAM_NAME' not found in AWS Parameter Store"
    log error ""
    log error "💡 Possible causes:"
    log error "   • The parameter was manually deleted from AWS SSM"
    log error "   • The external_id is stale"
    if [ -n "${EXTERNAL_ID_VERSION:-}" ]; then
      log error "   • Requested version '$EXTERNAL_ID_VERSION' is outside Parameter Store's retention window"
    fi
    log error ""
    log error "🔧 How to fix:"
    log error "   • Verify: aws ssm describe-parameters --filters Key=Name,Values=$PARAM_NAME --region $AWS_REGION"
    log error "   • If genuinely missing, the parameter value needs to be re-stored"
    exit 1
  else
    log error "❌ Failed to retrieve parameter '$PARAM_NAME' from AWS Parameter Store"
    log error ""
    log error "💡 Possible causes:"
    log error "   • IAM principal lacks ssm:GetParameter on this resource"
    log error "   • KMS key permission missing (kms:Decrypt) for SecureString"
    log error "   • Region '$AWS_REGION' unreachable"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Verify identity: aws sts get-caller-identity --region $AWS_REGION"
    log error "Underlying error: $err"
    exit 1
  fi
fi
